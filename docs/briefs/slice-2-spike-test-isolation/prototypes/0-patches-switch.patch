diff --git a/tally/src/test/java/com/tally/support/Patches.java b/tally/src/test/java/com/tally/support/Patches.java
new file mode 100644
index 0000000..73aa4c6
--- /dev/null
+++ b/tally/src/test/java/com/tally/support/Patches.java
@@ -0,0 +1,16 @@
+package com.tally.support;
+
+/**
+ * Spike on test isolation: switches off, for one run, every per-test patch that works around shared job rows
+ * (Slice 1R report §7), so a run shows which isolation option still needs them. Off with
+ * {@code -Dtally.spike.patches=off}; on by default, as on main.
+ */
+public final class Patches {
+
+    private Patches() {
+    }
+
+    public static boolean on() {
+        return !"off".equals(System.getProperty("tally.spike.patches"));
+    }
+}
