@@ -0,0 +1,40 @@
+package com.tally.platform.internal;
+
+import com.tally.platform.PeriodicJob;
+import org.springframework.context.ApplicationContext;
+
+/**
+ * Spike option C: tests drive background work themselves, on the calling thread, with the context's runners
+ * off. A periodic job runs by name, without its shared row: nothing is claimed or rescheduled, so no other
+ * context's clock can strand it, and no other context's run can stand in for this one's.
+ */
+public final class Drive {
+
+    private Drive() {
+    }
+
+    /** Runs the periodic job {@code name} (an invariant check is {@code invariant.<check>}) once, now. */
+    public static void job(ApplicationContext context, String name) throws Exception {
+        PeriodicJob job = context.getBean(InvariantJobs.class).jobs().stream()
+                .filter(j -> j.name().equals(name))
+                .findFirst()
+                .or(() -> context.getBeanProvider(PeriodicJob.class).orderedStream()
+                        .filter(j -> j.name().equals(name)).findFirst())
+                .orElseThrow(() -> new IllegalArgumentException("No periodic job " + name));
+        job.run();
+    }
+
+    /** Processes every due item of every registered queue, job tables included, until none is due. */
+    public static int allDue(ApplicationContext context) {
+        int handled = 0;
+        for (boolean more = true; more; ) {
+            more = false;
+            for (JdbcDurableQueue queue : context.getBean(JdbcDurableQueues.class).queues()) {
+                int n = queue.processDue();
+                handled += n;
+                more |= n > 0;
+            }
+        }
+        return handled;
+    }
+}
